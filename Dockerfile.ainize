# ainize build for a contracts package (no server of its own): compile EngramRegistrar.sol with solc 0.8.28,
# run the contract tests against an in-process ganache fixture (no Sepolia), then serve README.md rendered on $PORT.
FROM node:22-alpine AS build
WORKDIR /app
COPY . .
RUN npm ci
# ENSv2 interfaces are not on npm; fetch the public ensdomains/namechain source at the commit scripts/setup.sh pins
# (setup.sh does a git clone without submodules; a tarball of the same commit is equivalent).
ARG NAMECHAIN_PIN=48b3e2d39513b9dd32ef1850877a29009bc807b9
RUN mkdir namechain && wget -qO- https://codeload.github.com/ensdomains/namechain/tar.gz/${NAMECHAIN_PIN} | tar -xz -C namechain --strip-components=1
RUN npm run build && npm test
RUN mkdir -p /www && npx -y marked@12.0.2 -i README.md -o /tmp/readme.html \
 && { printf '<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>@ainize/ens</title><style>body{font:16px/1.6 system-ui,sans-serif;max-width:860px;margin:2rem auto;padding:0 16px}pre{background:#f4f4f4;padding:12px;overflow:auto}code{font-family:ui-monospace,monospace}table{border-collapse:collapse}td,th{border:1px solid #ccc;padding:4px 8px}</style></head><body>'; cat /tmp/readme.html; printf '</body></html>'; } > /www/index.html

FROM busybox:1.36
COPY --from=build /www /www
ENV PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "exec httpd -f -v -p 0.0.0.0:${PORT} -h /www"]
